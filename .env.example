# =====================================================================
# Kitobxon Hub — environment variables (namuna / template)
#
# Copy this file to ".env" for local development, or enter the same
# names/values in your hosting provider's "Environment" settings page.
# NEVER commit a real .env file or real secrets to Git.
# =====================================================================

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
# API documentation at /api/docs (off in production unless set to true)
API_DOCS_ENABLED=true
TIMEZONE=Asia/Tashkent

# Public HTTPS address where the backend is reachable (needed for the Telegram webhook
# and Mini App links), e.g. https://kitobxon-hub.onrender.com
PUBLIC_BASE_URL=

# Comma-separated list of extra origins allowed to call the API from a browser.
# Leave empty when the Mini App and Admin Panel are served by the backend itself.
CORS_ORIGINS=

# ---- Database (PostgreSQL) ----
# Any provider URL works, e.g. postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kitobxon
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- Redis (optional; leave empty to use in-memory fallbacks on a single server) ----
REDIS_URL=

# ---- Security ----
# Long random string (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=1440
ADMIN_TOKEN_TTL_MINUTES=720
# Telegram user IDs that automatically receive the SUPER_ADMIN role (comma-separated).
# Send /myid to the bot to learn your Telegram ID.
SUPER_ADMIN_TELEGRAM_IDS=

# ---- Telegram ----
# Token from @BotFather
BOT_TOKEN=
# Bot username without @, e.g. kitobxon_hub_bot
BOT_USERNAME=
# Public HTTPS URL of the Mini App, e.g. https://kitobxon-hub.onrender.com/app/
TELEGRAM_WEBAPP_URL=
# Random string used to verify that webhook calls really come from Telegram
TELEGRAM_WEBHOOK_SECRET=

# ---- Background worker (Telegram notifications, reminders, closing ended tests) ----
# Runs inside the web process. Set to false if you run `python -m app.workers` separately.
WORKER_ENABLED=true
# How often reminders are checked (seconds). 60 on a normal database; on Neon's free plan use
# 1800 so the database can sleep between checks.
WORKER_INTERVAL_SECONDS=60

# ---- File storage (photos, PDF reports) ----
# local = files on the server disk (development only); s3 = any S3-compatible storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# For S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3, MinIO ...):
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ---- AI report drafting (optional) ----
# Anthropic API key (console.anthropic.com). Without it, reports are drafted from a fixed
# template instead and everything else works the same.
AI_API_KEY=
AI_MODEL=claude-opus-5-5
