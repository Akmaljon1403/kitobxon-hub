# Copy to .env (in this folder) and fill in. Never send this file to anyone.

# The server's public address (a domain pointing to this server; ports 80 and 443 open).
DOMAIN=kitobxon.example.uz
PUBLIC_BASE_URL=https://kitobxon.example.uz

# A long random password for the database (e.g. from: openssl rand -hex 24).
POSTGRES_PASSWORD=

# COPY EXACTLY from the old server (Render → Environment). A different SECRET_KEY makes the
# saved promo codes unreadable.
SECRET_KEY=
BOT_TOKEN=
BOT_USERNAME=
SUPER_ADMIN_TELEGRAM_IDS=

# Files: keep the same Cloudflare R2 values as on Render (nothing to move),
# or use the server disk (STORAGE_BACKEND=local; the files are in ./data/storage).
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Server processes. 1 is enough for several thousand members (load test: ~120 requests a second);
# 2 for a very large club.
WEB_CONCURRENCY=1

# Optional
AI_API_KEY=
